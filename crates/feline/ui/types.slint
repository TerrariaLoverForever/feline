// Types shared between the UI and Rust. They're re-exported from app.slint so
// Rust can use them (e.g. `Page::Home`, `LaunchState::Running`).

export enum Page {
    home,
    runtimes,
    studio,
    mods,
    library,
    tweaks,
    servers,
    system,
    diagnostics,
    settings,
    about,
}

// What the Play area shows.
export enum LaunchState {
    idle,
    starting,
    running,
    ended,
    failed,
}

// One detected runtime installation, as shown in the list.
export struct RuntimeRow {
    // Stable identifier, saved in the settings when chosen.
    key: string,
    // The runtime project, e.g. "sober" (its settings tabs share this id).
    id: string,
    name: string,
    version: string,
    // How it's installed, e.g. "Flatpak (system)".
    kind: string,
    selected: bool,
}

// A game on the Home page (recently played, favourites).
export struct GameCard {
    // The place ID, as text (it doesn't fit Slint's int).
    place: string,
    name: string,
    // e.g. "2 h 5 min · yesterday"
    detail: string,
    icon: image,
    has-icon: bool,
    favourite: bool,
    // Shown as "something secret" on Discord.
    hidden: bool,
}

// One version in the Roblox page's history.
export struct VersionRow {
    version: string,
    // e.g. "since 3 days ago"
    when: string,
}

// A game and the profile chosen for it (0 = none).
export struct GameProfileRow {
    place: string,
    name: string,
    index: int,
}

// One public server in the server picker.
export struct ServerRow {
    id: string,
    // "12 / 20 players"
    players: string,
    // "80 ms ping · 60 FPS"
    detail: string,
    // How full, 0..1.
    fill: float,
}

// One line of "Most played".
export struct TopGame {
    name: string,
    time: string,
    // Playtime relative to the most played game, 0..1.
    share: float,
}

// One mod on the Mods page.
export struct ModRow {
    name: string,
    // What it changes and how many files, e.g. "sounds, fonts · 12 files".
    detail: string,
    enabled: bool,
    // A picture from the mod, and whether it has a sound to listen to.
    preview: image,
    has-preview: bool,
    has-sound: bool,
}

// A Bloxstrap-family mods folder found on this computer.
export struct FoundRow {
    // The bootstrapper, e.g. "Bloxstrap".
    name: string,
    detail: string,
}

// How a value or check result should be colored.
export enum Level {
    neutral,
    ok,
    warning,
    problem,
}

// One line of the System page, e.g. "Kernel" / "6.18.58_1".
export struct InfoRow {
    label: string,
    value: string,
    level: Level,
}

// One quick-check result on the Diagnostics page.
export struct CheckRow {
    level: Level,
    title: string,
    detail: string,
}

// A graphics card's driver on the System page.
export struct DriverRow {
    gpu: string,
    version: string,
    // "March 2024", or empty.
    date: string,
    level: Level,
    advice: string,
    // The maker's download page, or empty.
    link: string,
}

// One Roblox session the crash detective looked at.
export struct CaseRow {
    // "Today 23:17 · 25 min"
    when: string,
    game: string,
    // "Closed normally", "Lost connection…", "Closed unexpectedly"
    ending: string,
    level: Level,
    advice: string,
}

// One address the network test tried.
export struct ProbeRow {
    label: string,
    host: string,
    result: string,
    level: Level,
}

// What control a runtime setting uses.
export enum SettingKind {
    toggle,
    choice,
    number,
    text,
}

// One runtime setting on the Settings page.
export struct SettingRow {
    // The key in the runtime's settings file.
    key: string,
    label: string,
    help: string,
    kind: SettingKind,
    // Current value, in the field matching `kind`.
    on: bool,
    choices: [string],
    choice-index: int,
    number: int,
    min: int,
    max: int,
    text: string,
    placeholder: string,
    // Locked because a Feline setting overrides it.
    managed: bool,
    managed-reason: string,
    // Which of the runtime's tabs it's on, and its section's title (shown
    // above the first row of each section).
    tab: int,
    section: string,
    section-start: bool,
}

// One runtime's tab on the Settings page.
export struct RuntimeTab {
    // Backend id, e.g. "sober".
    id: string,
    name: string,
    // Which installation and file is being edited, e.g. "Flatpak · ~/.var/app/…".
    source: string,
    // Empty when everything is fine; otherwise why the settings can't be changed.
    status: string,
    status-level: Level,
    // False when the settings can be looked at but not changed right now.
    editable: bool,
    // Tab names, like the runtime's own launcher ("Settings" if just one).
    tabs: [string],
    rows: [SettingRow],
}
