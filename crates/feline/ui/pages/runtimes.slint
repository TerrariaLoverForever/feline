// Runtimes page: the runtimes Feline found (its own kept apart from the
// external third-party ones), and each runtime's own page with its settings
// in tabs, like that runtime's own launcher.

import { ScrollView, ComboBox, SpinBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { RuntimeRow, RuntimeTab, SettingKind, Level } from "../types.slint";
import { Icon, Icons } from "../icons.slint";
import { PageBase, Logo, Pill, SecondaryButton, Card, Eyebrow, BodyText, PageHeader, Divider, Toggle, TabBar, SettingRow, Banner, CatEmpty } from "../components.slint";

// A runtime's initial in a rounded tile (Feline's own shows its logo).
component RuntimeBadge inherits Rectangle {
    in property <string> name;
    in property <bool> feline;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: root.feline ? transparent : Theme.accent-soft;
    if root.feline: Logo {
        size: 42px;
    }
    if !root.feline: Icon {
        width: 20px;
        height: 20px;
        commands: Icons.runtimes;
        tone: Theme.lavender;
    }
}

// One runtime in the list: opens its page; "Use" chooses it.
component RuntimeCard inherits Rectangle {
    in property <RuntimeRow> entry;
    in property <bool> feline;
    in property <string> initial;
    callback select();
    callback open();
    property <bool> shown: false;

    height: 74px;
    border-radius: Theme.radius;
    border-width: 1px;
    background: touch.has-hover ? Theme.surface-raised : Theme.surface;
    border-color: entry.selected ? Theme.accent.with-alpha(0.55) : touch.has-hover ? Theme.border-strong : Theme.border;
    drop-shadow-blur: touch.has-hover ? Theme.lift-hover-blur : Theme.lift-blur;
    drop-shadow-offset-y: touch.has-hover ? Theme.lift-hover-offset : Theme.lift-offset;
    drop-shadow-color: Theme.lift-color;
    animate drop-shadow-blur, drop-shadow-offset-y { duration: Theme.normal; easing: ease-out-quint; }
    opacity: root.shown ? 1 : 0;
    animate background, border-color { duration: Theme.fast; }
    animate opacity { duration: Theme.normal; easing: ease-out-quad; }
    init => {
        root.shown = true;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            RuntimeBadge {
                name: root.initial;
                feline: root.feline;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.entry.name;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: root.entry.version;
                    font-size: 14px;
                    color: Theme.text-faint;
                }
            }
            Text {
                text: root.entry.kind;
                font-size: 12px;
                color: Theme.text-faint;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            if root.entry.selected: Pill {
                text: "In use";
                tone: Theme.success;
            }
            if !root.entry.selected: SecondaryButton {
                text: "Use";
                clicked => {
                    root.select();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                width: 16px;
                height: 16px;
                commands: Icons.chevron-right;
                tone: touch.has-hover ? Theme.text : Theme.text-faint;
            }
        }
    }
}

// The control for one runtime setting.
component SettingControl inherits HorizontalLayout {
    in property <RuntimeTab> tab;
    in property <int> index;
    callback set-bool(string, string, bool);
    callback set-choice(string, string, int);
    callback set-number(string, string, int);
    callback set-text(string, string, string);
    property <bool> editable: root.tab.editable && !root.tab.rows[root.index].managed;

    if root.tab.rows[root.index].kind == SettingKind.toggle: Toggle {
        checked: root.tab.rows[root.index].on;
        enabled: root.editable;
        toggled(on) => {
            root.set-bool(root.tab.id, root.tab.rows[root.index].key, on);
        }
    }
    if root.tab.rows[root.index].kind == SettingKind.choice: ComboBox {
        width: 220px;
        model: root.tab.rows[root.index].choices;
        current-index: root.tab.rows[root.index].choice-index;
        enabled: root.editable;
        selected => {
            root.set-choice(root.tab.id, root.tab.rows[root.index].key, self.current-index);
        }
    }
    if root.tab.rows[root.index].kind == SettingKind.text: LineEdit {
        width: 260px;
        text: root.tab.rows[root.index].text;
        placeholder-text: root.tab.rows[root.index].placeholder;
        enabled: root.editable;
        edited(t) => {
            root.set-text(root.tab.id, root.tab.rows[root.index].key, t);
        }
    }
    if root.tab.rows[root.index].kind == SettingKind.number: SpinBox {
        width: 130px;
        minimum: root.tab.rows[root.index].min;
        maximum: root.tab.rows[root.index].max;
        value: root.tab.rows[root.index].number;
        enabled: root.editable;
        edited(v) => {
            root.set-number(root.tab.id, root.tab.rows[root.index].key, v);
        }
    }
}

// A runtime's own page: header, then its settings in tabs.
component RuntimeDetail inherits VerticalLayout {
    in property <RuntimeRow> entry;
    in property <bool> feline;
    in property <string> initial;
    in property <[RuntimeTab]> tabs;
    callback back();
    callback select(string);
    callback set-bool(string, string, bool);
    callback set-choice(string, string, int);
    callback set-number(string, string, int);
    callback set-text(string, string, string);
    in-out property <int> current: 0;
    property <bool> has-settings: false;

    spacing: 16px;
    alignment: start;

    // Back to the list
    HorizontalLayout {
        alignment: start;
        back-button := Rectangle {
            height: 30px;
            border-radius: 8px;
            background: back-touch.has-hover ? Theme.surface-hover : transparent;
            animate background { duration: Theme.fast; }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 10px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 16px;
                        height: 16px;
                        commands: Icons.chevron-left;
                        tone: Theme.text-muted;
                    }
                }
                Text {
                    text: "All runtimes";
                    font-size: 13px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            back-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.back();
                }
            }
        }
    }

    // Header
    Card {
        inner-padding: 18px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                RuntimeBadge {
                    name: root.initial;
                    feline: root.feline;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: root.entry.name;
                        font-size: 22px;
                        font-weight: 800;
                        color: Theme.text;
                    }
                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: root.feline ? "Feline's own" : "Third-party";
                            tone: root.feline ? Theme.lavender : Theme.warning;
                        }
                    }
                }
                Text {
                    text: (root.entry.version != "" ? root.entry.version + " · " : "") + root.entry.kind;
                    font-size: 12.5px;
                    color: Theme.text-faint;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                if root.entry.selected: Pill {
                    text: "In use";
                    tone: Theme.success;
                }
                if !root.entry.selected: SecondaryButton {
                    text: "Use this runtime";
                    primary: true;
                    clicked => {
                        root.select(root.entry.key);
                    }
                }
            }
        }
    }

    // Spacing 0: the other runtimes' (hidden) entries take no room.
    VerticalLayout {
    spacing: 0px;
    for tab in root.tabs: VerticalLayout {
        if tab.id == root.entry.id: VerticalLayout {
            spacing: 14px;
            if tab.tabs.length > 1: TabBar {
                tabs: tab.tabs;
                current <=> root.current;
            }
            if tab.status != "": Banner {
                text: tab.status;
                tone: Theme.level-color(tab.status-level);
            }
            if tab.rows.length > 0: Card {
                // Spacing 0: other tabs' (hidden) rows take no room.
                VerticalLayout {
                spacing: 0px;
                // No `if` around the row's parts: inside one, Slint
                // measures wrapped help text as a single line and the rows
                // overlap in a narrow window. Hidden parts get height 0.
                for row[j] in tab.rows: Rectangle {
                    property <bool> shown: row.tab == root.current;
                    property <bool> titled: self.shown && row.section-start && row.section != "";
                    height: self.shown ? row-box-10.preferred-height : 0px;
                    visible: self.shown;
                    row-box-10 := VerticalLayout {
                    Rectangle {
                        height: titled ? (j > 0 ? 10px : 0px) + section-title.preferred-height + 6px : 0px;
                        visible: titled;
                        section-title := Text {
                            x: 0px;
                            y: j > 0 ? 10px : 0px;
                            text: row.section;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.lavender;
                        }
                    }
                    Divider {
                        height: shown && !row.section-start ? 1px : 0px;
                    }
                    SettingRow {
                        label: row.label;
                        help: row.help;
                        managed-reason: row.managed-reason;
                        SettingControl {
                            tab: tab;
                            index: j;
                            set-bool(t, k, v) => {
                                root.set-bool(t, k, v);
                            }
                            set-choice(t, k, i) => {
                                root.set-choice(t, k, i);
                            }
                            set-number(t, k, v) => {
                                root.set-number(t, k, v);
                            }
                            set-text(t, k, v) => {
                                root.set-text(t, k, v);
                            }
                        }
                    }
                }
                }
                }
            }
            if tab.source != "": BodyText {
                text: "Settings file: " + tab.source;
                color: Theme.text-faint;
                font-size: 12px;
            }
        }
    }
    }
}

export component RuntimesPage inherits PageBase {
    // True on Windows: shows the Windows wording and hides Linux-only parts.
    in property <bool> windows;
    in property <[RuntimeRow]> runtimes;
    in property <bool> detecting;
    in property <string> error;
    // Feline's own runtime, if it was found (at most one).
    in property <[RuntimeRow]> feline-runtimes;
    // The runtime whose page is open ("" = the list) and every runtime's
    // settings tabs.
    in property <string> open;
    in property <[RuntimeTab]> tabs;
    // The open tab of a runtime's page.
    in-out property <int> runtime-tab;
    callback select(string);
    callback rescan();
    callback open-runtime(string);
    callback set-bool(string, string, bool);
    callback set-choice(string, string, int);
    callback set-number(string, string, int);
    callback set-text(string, string, string);
    property <bool> has-feline: root.feline-runtimes.length > 0;

    ScrollView {
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            alignment: start;

            // ---------------- A runtime's own page (spacing 0: the
            // hidden entries take no room)
            VerticalLayout {
            spacing: 0px;
            for row in root.feline-runtimes: VerticalLayout {
                if row.id == root.open: RuntimeDetail {
                    current <=> root.runtime-tab;
                    entry: row;
                    feline: true;
                    initial: "F";
                    tabs: root.tabs;
                    back => {
                        root.open-runtime("");
                    }
                    select(key) => {
                        root.select(key);
                    }
                    set-bool(t, k, v) => {
                        root.set-bool(t, k, v);
                    }
                    set-choice(t, k, i) => {
                        root.set-choice(t, k, i);
                    }
                    set-number(t, k, v) => {
                        root.set-number(t, k, v);
                    }
                    set-text(t, k, v) => {
                        root.set-text(t, k, v);
                    }
                }
            }
            for row in root.runtimes: VerticalLayout {
                if row.id == root.open: RuntimeDetail {
                    current <=> root.runtime-tab;
                    entry: row;
                    feline: false;
                    initial: row.name;
                    tabs: root.tabs;
                    back => {
                        root.open-runtime("");
                    }
                    select(key) => {
                        root.select(key);
                    }
                    set-bool(t, k, v) => {
                        root.set-bool(t, k, v);
                    }
                    set-choice(t, k, i) => {
                        root.set-choice(t, k, i);
                    }
                    set-number(t, k, v) => {
                        root.set-number(t, k, v);
                    }
                    set-text(t, k, v) => {
                        root.set-text(t, k, v);
                    }
                }
            }

            }

            // ---------------- The list
            if root.open == "": VerticalLayout {
                spacing: 14px;
                PageHeader {
                    title: root.windows ? "Roblox" : "Runtimes";
                    description: root.windows
                        ? "The Roblox client Feline starts when you press Play. Feline finds it on its own, even after Roblox updates."
                        : "A runtime is the program that actually runs Roblox. Choose the one to play with, or open one to change its settings.";
                    SecondaryButton {
                        text: root.detecting ? "Scanning…" : "Rescan";
                        icon: Icons.refresh;
                        enabled: !root.detecting;
                        clicked => {
                            root.rescan();
                        }
                    }
                }

                if root.error != "": Banner {
                    text: root.error;
                    tone: Theme.danger;
                }

                if !root.windows: VerticalLayout {
                    padding-top: 6px;
                    Eyebrow {
                        text: "Feline's own";
                    }
                }
                for row in root.feline-runtimes: RuntimeCard {
                    entry: row;
                    feline: true;
                    initial: "F";
                    select => {
                        root.select(row.key);
                    }
                    open => {
                        root.open-runtime(row.id);
                    }
                }
                if !root.has-feline && !root.windows: Card {
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Logo {
                                size: 42px;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Feline Runtime";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            BodyText {
                                text: "Feline's own runtime is still napping. Install feline-runtime, run `feline --update-roblox` to fetch the Roblox app, then press Rescan.";
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    padding-top: 6px;
                    VerticalLayout {
                        alignment: center;
                        Eyebrow {
                            text: root.windows ? "Your Roblox client" : "Other people's runtimes";
                        }
                    }
                    Pill {
                        text: root.windows ? "Official" : "Third-party";
                        tone: root.windows ? Theme.success : Theme.warning;
                    }
                }
                BodyText {
                    text: root.windows
                        ? "Exactly as Roblox's installer put it on this PC. Feline starts it the same way Roblox's own shortcut does."
                        : "Separate programs you installed yourself. Feline starts them through their public command line and contains none of their code.";
                }

                for row in root.runtimes: RuntimeCard {
                    entry: row;
                    feline: false;
                    initial: row.name;
                    select => {
                        root.select(row.key);
                    }
                    open => {
                        root.open-runtime(row.id);
                    }
                }

                if root.detecting && root.runtimes.length == 0: BodyText {
                    text: root.windows ? "Sniffing out Roblox…" : "Sniffing out runtimes…";
                }
                if !root.detecting && root.runtimes.length == 0: Card {
                    CatEmpty {
                        title: root.windows ? "No Roblox here yet" : "No runtimes to play with yet";
                        text: root.windows
                            ? "Install Roblox from roblox.com, then press Rescan. Feline will sniff it out right away."
                            : "Feline works with Sober, Cordial, Stud, Tipsy, Mocktail and Nightcap. Install one, then press Rescan.";
                    }
                }
            }

            // The Roblox tools (status, versions, profiles, repair); they
            // hide themselves while a runtime's own page is open.
            @children
        }
    }
}
