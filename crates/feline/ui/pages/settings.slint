// SPDX-License-Identifier: GPL-3.0-or-later
// Settings page: Feline's own settings, in tabs. Each runtime's own settings
// are on its page under Runtimes.

import { ScrollView, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Level } from "../types.slint";
import { Icons } from "../icons.slint";
import { PageBase, Card, Eyebrow, BodyText, PageHeader, Divider, Toggle, TabBar, SettingRow, SectionTitle, SecondaryButton, ConfirmButton, Banner } from "../components.slint";

// One of Feline's override settings: a dropdown.
component OverrideRow inherits SettingRow {
    in property <[string]> options;
    in property <int> index;
    callback changed(int);
    ComboBox {
        width: 230px;
        model: root.options;
        current-index: root.index;
        selected => {
            root.changed(self.current-index);
        }
    }
}

// A storage line: what it is, how big, and a button.
component StorageRow inherits SettingRow {
    in property <string> size;
    in property <string> action;
    in property <bool> danger: true;
    callback act();
    HorizontalLayout {
        spacing: 14px;
        Text {
            text: root.size;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
            min-width: 70px;
            horizontal-alignment: right;
        }
        if root.danger: ConfirmButton {
            text: root.action;
            icon: Icons.trash;
            confirmed => {
                root.act();
            }
        }
        if !root.danger: SecondaryButton {
            text: root.action;
            clicked => {
                root.act();
            }
        }
    }
}

export component SettingsPage inherits PageBase {
    // Feline's override settings (index into each options list).
    in property <int> renderer-index;
    in property <int> gamemode-index;
    in property <int> close-index;
    // Result of applying Feline's settings to the runtimes.
    in property <string> apply-status;
    in property <Level> apply-level;

    // Feline's Discord status.
    in property <bool> discord-on;
    in property <bool> discord-user;
    in property <bool> discord-join;
    in property <bool> discord-game;
    in property <bool> discord-menus;
    in property <string> presence-status;
    in property <bool> link-handler;
    in property <string> link-status;

    // Updates, privacy and storage.
    in property <bool> roblox-updates;
    in property <string> roblox-status;
    in property <int> log-days-index;
    in property <bool> has-saved-login;
    in property <string> size-roblox-cache;
    in property <string> size-roblox-logs;
    in property <string> size-feline-logs;
    in property <string> size-roblox-versions;
    in property <string> housekeeping-status;

    callback set-link-handler(bool);
    callback set-presence(string, bool);
    callback set-override(string, int);
    callback set-roblox-updates(bool);
    callback set-log-days(int);
    // "delete-roblox-logs", "delete-feline-logs", "forget-login",
    // "clear-cache", "check-update", "refresh"
    callback housekeeping(string);
    // Opens Feline Runtime's "Privacy & network" tab.
    callback open-runtime-privacy();

    in-out property <int> current: 0;
    property <[string]> toggle-options: ["Let each runtime decide", "On", "Off"];

    ScrollView {
        VerticalLayout {
            padding: 30px;
            spacing: 16px;
            alignment: start;

            PageHeader {
                title: "Settings";
                description: "Feline's own settings. Each runtime's settings are on its page under Runtimes.";
            }

            TabBar {
                tabs: ["General", "Overrides", "Discord", "Privacy", "Storage", "Updates"];
                current <=> root.current;
                changed(i) => {
                    if i == 4 {
                        root.housekeeping("refresh");
                    }
                }
            }

            if root.housekeeping-status != "": Banner {
                text: root.housekeeping-status;
                tone: Theme.success;
            }

            // ---------------- General
            if root.current == 0: Card {
                SectionTitle {
                    text: "Roblox links";
                    icon: Icons.link;
                }
                SettingRow {
                    label: "Open Roblox links from the website with Feline";
                    help: "When you press Play on roblox.com, Feline starts your chosen runtime (with your Discord status, if it's on). Feline gives the links back to the app that had them when you switch this off.";
                    Toggle {
                        checked: root.link-handler;
                        toggled(on) => {
                            root.set-link-handler(on);
                        }
                    }
                }
                if root.link-status != "": BodyText {
                    text: root.link-status;
                }
            }

            // ---------------- Overrides
            if root.current == 1: Card {
                SectionTitle {
                    text: "For every runtime";
                    icon: Icons.sliders;
                }
                BodyText {
                    text: "These replace the matching setting of Sober, Cordial and Stud. Feline writes them into each runtime's settings file now, and again every time it starts a game.";
                }
                OverrideRow {
                    label: "Renderer";
                    help: "Cordial's renderer isn't changed: its OpenGL ES setting isn't documented. Feline's own runtime always uses Vulkan when it can.";
                    options: ["Let each runtime decide", "Vulkan", "OpenGL"];
                    index: root.renderer-index;
                    changed(i) => {
                        root.set-override("renderer", i);
                    }
                }
                Divider { }
                OverrideRow {
                    label: "GameMode";
                    help: "Feral GameMode can boost performance while you play, if it's installed.";
                    options: root.toggle-options;
                    index: root.gamemode-index;
                    changed(i) => {
                        root.set-override("gamemode", i);
                    }
                }
                Divider { }
                OverrideRow {
                    label: "Close the runtime when leaving a game";
                    options: root.toggle-options;
                    index: root.close-index;
                    changed(i) => {
                        root.set-override("close-on-leave", i);
                    }
                }
                if root.apply-status != "": Banner {
                    text: root.apply-status;
                    tone: Theme.level-color(root.apply-level);
                }
            }

            // ---------------- Discord
            if root.current == 2: Card {
                SectionTitle {
                    text: "Discord status";
                    icon: Icons.discord;
                }
                SettingRow {
                    label: "Show what you're playing on Discord";
                    help: "Works with every runtime, and keeps going if you close Feline's window, until the game ends. Turns off Sober's and Stud's own Discord status, so they don't fight over it.";
                    Toggle {
                        checked: root.discord-on;
                        toggled(on) => {
                            root.set-presence("enabled", on);
                        }
                    }
                }
                Divider { }
                SettingRow {
                    label: "\"See this game\" button";
                    help: "Links to the game's Roblox page.";
                    Toggle {
                        checked: root.discord-game;
                        enabled: root.discord-on;
                        toggled(on) => {
                            root.set-presence("game-button", on);
                        }
                    }
                }
                Divider { }
                SettingRow {
                    label: "\"Join server\" button";
                    help: "Anyone who can see your Discord profile could join the server you're on.";
                    Toggle {
                        checked: root.discord-join;
                        enabled: root.discord-on;
                        toggled(on) => {
                            root.set-presence("join-button", on);
                        }
                    }
                }
                Divider { }
                SettingRow {
                    label: "Show your Roblox username and avatar";
                    Toggle {
                        checked: root.discord-user;
                        enabled: root.discord-on;
                        toggled(on) => {
                            root.set-presence("show-user", on);
                        }
                    }
                }
                Divider { }
                SettingRow {
                    label: "Show a status in the Roblox menus";
                    help: "Otherwise there's no status between games.";
                    Toggle {
                        checked: root.discord-menus;
                        enabled: root.discord-on;
                        toggled(on) => {
                            root.set-presence("in-menus", on);
                        }
                    }
                }
                if root.discord-on && root.presence-status != "": Banner {
                    text: root.presence-status;
                }
            }

            // ---------------- Privacy & security
            if root.current == 3: Card {
                SectionTitle {
                    text: "Your Roblox login";
                    icon: Icons.lock;
                }
                SettingRow {
                    label: "Saved login for Feline's runtime";
                    help: root.has-saved-login
                        ? "Saved only on this computer, readable only by you, and sent only to Roblox. Feline never sees your password."
                        : "Not signed in. Feline's runtime asks you to sign in when it starts.";
                    ConfirmButton {
                        text: "Sign out";
                        icon: Icons.logout;
                        enabled: root.has-saved-login;
                        confirmed => {
                            root.housekeeping("forget-login");
                        }
                    }
                }
            }
            if root.current == 3: Card {
                SectionTitle {
                    text: "Logs";
                    icon: Icons.log;
                }
                BodyText {
                    text: "Roblox writes its own logs while it runs, and Feline keeps one log per game for bug reports. Logs can contain your username and the games you played; typed text is never in Feline's logs.";
                }
                SettingRow {
                    label: "Delete logs automatically";
                    help: "Old logs are removed each time Feline opens.";
                    ComboBox {
                        width: 180px;
                        model: ["Keep them", "After 1 day", "After 7 days", "After 30 days"];
                        current-index: root.log-days-index;
                        selected => {
                            root.set-log-days(self.current-index);
                        }
                    }
                }
                Divider { }
                StorageRow {
                    label: "Roblox's logs";
                    help: "What the Roblox app itself writes (Feline's runtime).";
                    size: root.size-roblox-logs;
                    action: "Delete";
                    act => {
                        root.housekeeping("delete-roblox-logs");
                    }
                }
                Divider { }
                StorageRow {
                    label: "Feline's logs";
                    help: "One per game, from every runtime.";
                    size: root.size-feline-logs;
                    action: "Delete";
                    act => {
                        root.housekeeping("delete-feline-logs");
                    }
                }
            }
            if root.current == 3: Card {
                SectionTitle {
                    text: "Tracking and proxy";
                    icon: Icons.shield;
                }
                SettingRow {
                    label: "Block Roblox tracking, use a proxy";
                    help: "For Feline's own runtime: blocking Roblox's analytics and telemetry (on by default), and a proxy for Roblox's web traffic (off by default). External runtimes have their own network handling.";
                    SecondaryButton {
                        text: "Open";
                        icon: Icons.chevron-right;
                        clicked => {
                            root.open-runtime-privacy();
                        }
                    }
                }
            }
            if root.current == 3: Card {
                SectionTitle {
                    text: "Security";
                    icon: Icons.shield-check;
                }
                BodyText {
                    text: "Roblox updates are only installed if they're signed with Roblox's own certificate (Android's APK signature, checked in full). Feline contains no Roblox files and never sends your data anywhere but Roblox and, if it's on, Discord on this computer.";
                }
            }

            // ---------------- Storage
            if root.current == 4: Card {
                SectionTitle {
                    text: "Space used by Feline's runtime";
                    icon: Icons.storage;
                }
                StorageRow {
                    label: "Roblox's content cache";
                    help: "Game models, textures and sounds Roblox saved. Safe to clear; games load a little slower the next time.";
                    size: root.size-roblox-cache;
                    action: "Clear";
                    act => {
                        root.housekeeping("clear-cache");
                    }
                }
                Divider { }
                StorageRow {
                    label: "Roblox app versions";
                    help: "The current Roblox app, and the last one that worked (kept so Feline can go back if an update breaks).";
                    size: root.size-roblox-versions;
                    action: "Refresh";
                    danger: false;
                    act => {
                        root.housekeeping("refresh");
                    }
                }
                Divider { }
                StorageRow {
                    label: "Logs";
                    help: "Roblox's and Feline's (see Privacy).";
                    size: root.size-roblox-logs + " + " + root.size-feline-logs;
                    action: "Delete";
                    act => {
                        root.housekeeping("delete-roblox-logs");
                        root.housekeeping("delete-feline-logs");
                    }
                }
            }

            // ---------------- Updates
            if root.current == 5: Card {
                SectionTitle {
                    text: "Roblox app";
                    icon: Icons.download;
                }
                SettingRow {
                    label: "Keep Roblox up to date";
                    help: "For Feline's own runtime: when Feline opens, it downloads a new Roblox version if there is one (checked against Roblox's signature). If a new version doesn't work, Feline goes back to the last one that did.";
                    Toggle {
                        checked: root.roblox-updates;
                        toggled(on) => {
                            root.set-roblox-updates(on);
                        }
                    }
                }
                Divider { }
                SettingRow {
                    label: "Check now";
                    help: root.roblox-status != "" ? root.roblox-status : "Not checked yet.";
                    SecondaryButton {
                        text: "Check for updates";
                        icon: Icons.refresh;
                        clicked => {
                            root.housekeeping("check-update");
                        }
                    }
                }
            }
        }
    }
}
