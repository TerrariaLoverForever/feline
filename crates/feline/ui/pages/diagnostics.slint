// SPDX-License-Identifier: GPL-3.0-or-later
// Diagnostics page: Feline's own quick checks, the selected runtime's
// self-check and info, a combined bug report, and where the logs are.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CheckRow, CaseRow, ProbeRow, Level } from "../types.slint";
import { Icons } from "../icons.slint";
import { PageBase, Pill, StatusDot, SecondaryButton, Card, Eyebrow, BodyText, PageTitle, Divider, OutputBox, SectionTitle, CatEmpty } from "../components.slint";

// Rows made from a list are wrapped in a Rectangle whose height is pinned to
// its content: otherwise Slint sizes the card as if every wrapped paragraph
// were one line, and the rows spill out of the bottom of the card.
component CheckLine inherits HorizontalLayout {
    in property <CheckRow> check;
    spacing: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    VerticalLayout {
        alignment: start;
        padding-top: 5px;
        StatusDot {
            tone: Theme.level-color(root.check.level);
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        Text {
            text: root.check.title;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.check.detail != "": BodyText {
            text: root.check.detail;
        }
    }
}

export component DiagnosticsPage inherits PageBase {
    // True on Windows: shows the Windows wording and hides Linux-only parts.
    in property <bool> windows;
    in property <[CheckRow]> checks;
    in property <bool> checks-loading;

    // The selected runtime; empty = none selected.
    in property <string> runtime-name;
    // What the selected runtime offers.
    in property <bool> runtime-has-doctor;
    in property <bool> runtime-has-info;
    // True while a self-check or report is being produced.
    in property <bool> running;
    // Result of the last action.
    in property <string> result-title;
    in property <Level> result-level;
    in property <string> output;

    in property <string> log-folder;

    // Crash detective
    in property <[CheckRow]> clues;
    in property <[CaseRow]> cases;
    in property <bool> investigating;
    callback investigate();
    // Network test
    in property <[ProbeRow]> probes;
    in property <Level> net-level;
    in property <string> net-title;
    in property <string> net-detail;
    in property <bool> net-running;
    callback run-network-test();
    // Bug report zip
    callback save-report-zip();

    callback run-doctor();
    callback run-runtime-info();
    callback build-report();
    callback open-logs();
    callback choose-runtime();

    property <bool> has-runtime: root.runtime-name != "";

    ScrollView {
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            alignment: start;

            VerticalLayout {
                spacing: 6px;
                PageTitle {
                    text: "Diagnostics";
                }
                BodyText {
                    text: "Figure out why something broke, and gather what a bug report needs.";
                }
            }

            Card {
                Eyebrow {
                    text: "Quick checks";
                }
                if root.checks-loading && root.checks.length == 0: BodyText {
                    text: "Checking…";
                }
                for check[i] in root.checks: Rectangle {
                    height: check-box.preferred-height;
                    check-box := VerticalLayout {
                        if i > 0: Divider { }
                        CheckLine {
                            check: check;
                        }
                    }
                }
            }

            // ---------------- Crash detective
            Card {
                HorizontalLayout {
                    spacing: 12px;
                    SectionTitle {
                        horizontal-stretch: 1;
                        text: "Crash detective";
                        icon: Icons.search;
                    }
                    SecondaryButton {
                        text: root.investigating ? "Sniffing around…" : "Investigate";
                        icon: Icons.search;
                        enabled: !root.investigating;
                        horizontal-stretch: 0;
                        clicked => {
                            root.investigate();
                        }
                    }
                }
                BodyText {
                    text: "Reads Roblox's own logs to work out how your last sessions ended, and what to try if something keeps going wrong.";
                }
                for clue[i] in root.clues: Rectangle {
                    height: clue-box.preferred-height;
                    clue-box := VerticalLayout {
                        if i > 0: Divider { }
                        CheckLine {
                            check: clue;
                        }
                    }
                }
                if root.cases.length > 0: Eyebrow {
                    text: "Recent sessions";
                }
                for c[i] in root.cases: Rectangle {
                    height: case-box.preferred-height;
                    border-radius: Theme.radius-small;
                    background: Theme.surface-raised;
                    case-box := HorizontalLayout {
                        padding: 10px;
                        padding-left: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 5px;
                            StatusDot {
                                tone: Theme.level-color(c.level);
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: c.game;
                                    font-size: 13.5px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: c.when;
                                    font-size: 12px;
                                    color: Theme.text-faint;
                                }
                            }
                            Text {
                                text: c.ending;
                                font-size: 12.5px;
                                color: Theme.level-color(c.level);
                                wrap: word-wrap;
                            }
                            if c.advice != "": BodyText {
                                text: c.advice;
                            }
                        }
                    }
                }
            }

            // ---------------- Network test
            Card {
                HorizontalLayout {
                    spacing: 12px;
                    SectionTitle {
                        horizontal-stretch: 1;
                        text: "Network test";
                        icon: Icons.network;
                    }
                    SecondaryButton {
                        text: root.net-running ? "Testing…" : (root.probes.length > 0 ? "Test again" : "Run the test");
                        icon: Icons.network;
                        enabled: !root.net-running;
                        horizontal-stretch: 0;
                        clicked => {
                            root.run-network-test();
                        }
                    }
                }
                BodyText {
                    text: "Checks that this PC can reach Roblox's sign-in, game servers, content and updates, how quickly, and pings the last server you played on.";
                }
                if root.net-title != "": CheckLine {
                    check: { level: root.net-level, title: root.net-title, detail: root.net-detail };
                }
                for p[i] in root.probes: Rectangle {
                    height: probe-box.preferred-height;
                    probe-box := VerticalLayout {
                    spacing: 0px;
                    if i > 0: Divider { }
                    HorizontalLayout {
                        spacing: 12px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        VerticalLayout {
                            alignment: center;
                            StatusDot {
                                tone: Theme.level-color(p.level);
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: p.label;
                                font-size: 13.5px;
                                font-weight: 600;
                                color: Theme.text;
                            }
                            Text {
                                text: p.host;
                                font-size: 11.5px;
                                color: Theme.text-faint;
                            }
                        }
                        Text {
                            text: p.result;
                            font-size: 13px;
                            color: p.level == Level.ok ? Theme.text-muted : Theme.level-color(p.level);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            wrap: word-wrap;
                            max-width: 260px;
                        }
                    }
                }
                }
            }

            Card {
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        SectionTitle {
                            text: root.windows ? "Bug report" : "Runtime checks and bug report";
                            icon: Icons.log;
                        }
                    }
                    if root.has-runtime: Pill {
                        text: root.runtime-name;
                        tone: Theme.lavender;
                    }
                }
                if !root.has-runtime: HorizontalLayout {
                    spacing: 12px;
                    BodyText {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        text: root.windows ? "Choose Roblox first, so the bug report knows which client you play with."
                            : "Choose a runtime first. Its self-check looks for problems Feline can't see, such as missing graphics or sound support.";
                    }
                    SecondaryButton {
                        text: root.windows ? "Choose Roblox" : "Choose a runtime";
                        clicked => {
                            root.choose-runtime();
                        }
                    }
                }
                if root.has-runtime && (root.runtime-has-doctor || root.runtime-has-info): BodyText {
                    text: "The self-check asks the runtime to test the display, GPU and Vulkan, sound and more. Runtime info is the block its developers ask for in bug reports.";
                }
                if root.has-runtime && !root.runtime-has-doctor && !root.runtime-has-info: BodyText {
                    text: root.windows
                        ? "Everything Feline knows about your PC, Roblox and recent games, in one block you can paste into a bug report. Personal bits (your user name in paths, anything that looks like a login) are hidden first."
                        : root.runtime-name + " has no self-check of its own. The quick checks above and the full bug report still work.";
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    if root.runtime-has-doctor: SecondaryButton {
                        text: "Run self-check";
                        icon: Icons.stethoscope;
                        enabled: root.has-runtime && root.runtime-has-doctor && !root.running;
                        clicked => {
                            root.run-doctor();
                        }
                    }
                    if root.runtime-has-info: SecondaryButton {
                        text: "Runtime info";
                        icon: Icons.about;
                        enabled: root.has-runtime && root.runtime-has-info && !root.running;
                        clicked => {
                            root.run-runtime-info();
                        }
                    }
                    SecondaryButton {
                        text: "Make a bug report";
                        icon: Icons.copy;
                        enabled: !root.running;
                        clicked => {
                            root.build-report();
                        }
                    }
                    SecondaryButton {
                        text: "Save as zip";
                        icon: Icons.archive;
                        enabled: !root.running;
                        clicked => {
                            root.save-report-zip();
                        }
                    }
                }
                if root.result-title != "": HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        StatusDot {
                            tone: Theme.level-color(root.result-level);
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.result-title;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
                OutputBox {
                    height: 260px;
                    text: root.output;
                    placeholder: root.running ? "Working on it… (a self-check can take a few seconds)" : "Output shows up here.";
                }
            }

            Card {
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Eyebrow {
                            text: "Logs";
                        }
                        BodyText {
                            text: "Each game's output goes into its own file in " + root.log-folder + ". Feline keeps the most recent ones.";
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SecondaryButton {
                            text: "Open logs folder";
                            icon: Icons.folder;
                            clicked => {
                                root.open-logs();
                            }
                        }
                    }
                }
            }
        }
    }
}
