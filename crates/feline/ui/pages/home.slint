// SPDX-License-Identifier: GPL-3.0-or-later
// Home page: the Play button with the chosen runtime, the launch status, live
// stats while a game runs, and a few facts at a glance.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { LaunchState } from "../types.slint";
import { Icon, Icons } from "../icons.slint";
import { PageBase, Logo, PlayButton, SecondaryButton, StatusDot, BodyText, StatTile, Banner } from "../components.slint";

export component HomePage inherits PageBase {
    // Selected runtime (set from Rust). Empty name = nothing selected.
    in property <string> selected-name;
    in property <string> selected-detail;
    in property <bool> detecting;

    // Launch status (set from Rust).
    in property <LaunchState> launch-state;
    in property <string> launch-title;
    in property <string> launch-detail;
    // Basic monitoring (set from Rust); empty until the first sample.
    in property <string> stat-time;
    in property <string> stat-cpu;
    in property <string> stat-memory;
    // Roblox app updates for Feline's runtime ("" = nothing to show).
    in property <string> roblox-status;
    in property <bool> discord-on;

    callback play();
    callback choose-runtime();
    callback open-logs();

    property <bool> has-runtime: root.selected-name != "";
    property <bool> busy: root.launch-state == LaunchState.starting || root.launch-state == LaunchState.running;

    ScrollView {
        VerticalLayout {
            padding: 30px;
            spacing: 18px;
            alignment: start;

            // Hero
            Rectangle {
                height: 236px;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.border;
                background: @linear-gradient(125deg, #231f3d 0%, #1a1a28 45%, #15161e 100%);
                clip: true;

                // Soft light behind the logo, and a faint ring
                Rectangle {
                    x: -80px;
                    y: -80px;
                    width: 330px;
                    height: 330px;
                    border-radius: 165px;
                    background: @radial-gradient(circle, #8f7ef72e 0%, #8f7ef700 70%);
                }
                Rectangle {
                    x: parent.width - 300px;
                    y: -110px;
                    width: 420px;
                    height: 420px;
                    border-radius: 210px;
                    border-width: 1px;
                    border-color: #8f7ef71a;
                }

                HorizontalLayout {
                    padding-left: 34px;
                    padding-right: 34px;
                    spacing: 28px;
                    VerticalLayout {
                        alignment: center;
                        Logo {
                            size: 120px;
                            glow: true;
                            playful: true;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.launch-state == LaunchState.running ? "Have fun!" : "Ready to play?";
                            font-size: 36px;
                            font-weight: 800;
                            color: Theme.text;
                        }
                        Text {
                            text: "Roblox on Linux. Always lands on its feet.";
                            font-size: 14px;
                            color: Theme.text-muted;
                        }
                        Rectangle {
                            height: 14px;
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            PlayButton {
                                text: root.launch-state == LaunchState.starting ? "Starting…"
                                    : root.launch-state == LaunchState.running ? "Running" : "Play Roblox";
                                enabled: root.has-runtime && !root.busy;
                                clicked => {
                                    root.play();
                                }
                            }
                            // The chosen runtime; click to change it
                            chip := Rectangle {
                                border-radius: Theme.radius;
                                background: chip-touch.has-hover ? #ffffff0c : #ffffff06;
                                border-width: 1px;
                                border-color: chip-touch.has-hover ? Theme.border-strong : Theme.border;
                                animate background, border-color { duration: Theme.fast; }
                                HorizontalLayout {
                                    padding: 10px;
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 11px;
                                    VerticalLayout {
                                        alignment: center;
                                        StatusDot {
                                            tone: root.detecting ? Theme.text-faint
                                                : root.has-runtime ? Theme.success : Theme.warning;
                                            pulse: root.detecting;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.detecting ? "Looking for runtimes…"
                                                : root.has-runtime ? root.selected-name : "No runtime chosen";
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: Theme.text;
                                        }
                                        Text {
                                            text: root.has-runtime ? root.selected-detail : "Choose one to start playing";
                                            font-size: 12px;
                                            color: root.has-runtime ? Theme.text-faint : Theme.lavender;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            width: 15px;
                                            height: 15px;
                                            commands: Icons.chevron-right;
                                            tone: chip-touch.has-hover ? Theme.text : Theme.text-faint;
                                        }
                                    }
                                }
                                chip-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.choose-runtime();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Launch status, only while something is happening or just happened
            if root.launch-state != LaunchState.idle: Rectangle {
                property <bool> shown: false;
                opacity: self.shown ? 1 : 0;
                transform-scale: self.shown ? 1 : 0.985;
                animate opacity { duration: Theme.normal; easing: ease-out-quad; }
                animate transform-scale { duration: Theme.slow; easing: ease-out-quint; }
                animate background, border-color { duration: Theme.normal; }
                init => {
                    self.shown = true;
                }
                border-radius: Theme.radius;
                border-width: 1px;
                background: root.launch-state == LaunchState.failed ? Theme.danger.with-alpha(0.07) : Theme.surface;
                border-color: root.launch-state == LaunchState.failed ? Theme.danger.with-alpha(0.35) : Theme.border;
                HorizontalLayout {
                    padding: 18px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 5px;
                        StatusDot {
                            tone: root.launch-state == LaunchState.failed ? Theme.danger
                                : root.launch-state == LaunchState.ended ? Theme.text-faint
                                : root.launch-state == LaunchState.running ? Theme.success : Theme.accent;
                            pulse: root.launch-state == LaunchState.starting;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.launch-title;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if root.launch-detail != "": BodyText {
                            text: root.launch-detail;
                        }
                    }
                    if root.launch-state == LaunchState.failed || root.launch-state == LaunchState.ended: VerticalLayout {
                        alignment: center;
                        SecondaryButton {
                            text: "Open logs";
                            icon: Icons.folder;
                            clicked => {
                                root.open-logs();
                            }
                        }
                    }
                }
            }

            // Live stats while a game runs
            if root.launch-state == LaunchState.running && root.stat-time != "": HorizontalLayout {
                spacing: 12px;
                StatTile {
                    horizontal-stretch: 1;
                    icon: Icons.clock;
                    label: "Playing for";
                    value: root.stat-time;
                    tone: Theme.success;
                }
                StatTile {
                    horizontal-stretch: 1;
                    icon: Icons.cpu;
                    label: "CPU";
                    value: root.stat-cpu;
                    tone: Theme.info;
                }
                StatTile {
                    horizontal-stretch: 1;
                    icon: Icons.memory;
                    label: "Memory";
                    value: root.stat-memory;
                    tone: Theme.warning;
                }
            }

            // At a glance
            HorizontalLayout {
                spacing: 12px;
                StatTile {
                    horizontal-stretch: 1;
                    icon: Icons.runtimes;
                    label: "Runtime";
                    value: root.has-runtime ? root.selected-name : "Not chosen";
                }
                StatTile {
                    horizontal-stretch: 1;
                    icon: Icons.download;
                    label: "Roblox app";
                    value: root.roblox-status != "" ? root.roblox-status : "Managed by the runtime";
                }
                StatTile {
                    horizontal-stretch: 1;
                    icon: Icons.discord;
                    label: "Discord status";
                    value: root.discord-on ? "On" : "Off";
                    tone: root.discord-on ? Theme.lavender : Theme.text-faint;
                }
            }

            Banner {
                text: "Roblox doesn't support third-party clients on Linux. Using one can put your account at risk.";
                tone: Theme.warning;
            }
        }
    }
}
