// SPDX-License-Identifier: GPL-3.0-or-later
// Reusable building blocks with Feline's look ("The Night-Lit Den", see
// DESIGN.md). Every colour comes from Theme, so the light and dark dens and
// any accent colour work everywhere.
//
// Performance note: there are no endless animations. Everything animates
// only in response to something happening (hover, press, focus, a page or
// card appearing), so the launcher draws nothing while idle and costs no GPU
// time while you play. The only repeating animation, the "starting" pulse of
// a StatusDot, runs only while a game is starting.
//
// How "appear" animations work: an element starts with `shown: false`
// (transparent, slightly smaller); its `init` callback, which Slint runs when
// the element is created, sets `shown: true`, and `animate` turns that change
// into a smooth transition. Elements inside `if` are created each time the
// condition becomes true, so they animate in every time.
//
// Keyboard: buttons, switches, tabs and the sidebar take focus with Tab
// (not with a click), show an accent ring while focused, and act on Space
// or Enter.

import { TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";

// The base of every page: fades in and settles to full size when opened.
export component PageBase inherits Rectangle {
    property <bool> shown: false;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.normal; easing: ease-out-quad; }
    init => {
        root.shown = true;
    }
}

// The keyboard-focus ring: drawn just outside its parent, in the accent.
// Put it last in a control so it sits on top.
component FocusRing inherits Rectangle {
    in property <bool> show;
    in property <length> radius;
    // The size of the control it rings.
    in property <length> around-width;
    in property <length> around-height;
    x: -3px;
    y: -3px;
    width: root.around-width + 6px;
    height: root.around-height + 6px;
    border-radius: root.radius + 3px;
    border-width: root.show ? Theme.focus-width : 0px;
    border-color: Theme.accent;
    opacity: root.show ? 1 : 0;
    animate opacity { duration: Theme.fast; }
}

// The Feline logo with rounded corners and an optional soft glow.
// With `playful`, the cat tilts its head when you hover over it.
export component Logo inherits Rectangle {
    in property <length> size: 48px;
    in property <bool> glow: false;
    in property <bool> playful: false;
    width: size;
    height: size;
    border-radius: size * 0.24;
    drop-shadow-blur: glow ? (hover.has-hover ? size * 0.5 : size * 0.32) : 0px;
    drop-shadow-color: Theme.accent.with-alpha(Theme.dark ? 0.45 : 0.35);
    transform-rotation: hover.has-hover ? -6deg : 0deg;
    transform-scale: hover.has-hover ? 1.04 : 1;
    animate transform-rotation, transform-scale { duration: Theme.slow; easing: ease-out-back; }
    animate drop-shadow-blur { duration: Theme.normal; }
    hover := TouchArea {
        enabled: root.playful;
    }
    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../../assets/icons/hicolor/256x256/apps/feline.png");
            image-fit: cover;
        }
    }
}

// A small rounded label, e.g. "Third-party" or "In use".
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.accent-ink;
    height: 22px;
    border-radius: 11px;
    background: tone.with-alpha(Theme.dark ? 0.13 : 0.11);
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A round status indicator with a soft glow. `pulse` makes it breathe
// (used only while something is starting, so it never runs for long).
export component StatusDot inherits Rectangle {
    in property <color> tone;
    in property <bool> pulse: false;
    property <bool> dim: false;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tone;
    opacity: root.pulse && root.dim ? 0.35 : 1;
    drop-shadow-blur: root.pulse && root.dim ? 2px : (Theme.dark ? 7px : 4px);
    drop-shadow-color: tone.with-alpha(0.6);
    animate opacity, drop-shadow-blur { duration: 600ms; easing: ease-in-out-sine; }
    animate background { duration: Theme.normal; }
    Timer {
        interval: 600ms;
        running: root.pulse;
        triggered => {
            root.dim = !root.dim;
        }
    }
}

// A sidebar navigation entry with an icon.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    // Shows a "Soon" pill for pages that aren't built yet.
    in property <bool> soon;
    callback clicked;

    height: 34px;
    border-radius: Theme.radius-small;
    background: root.active ? Theme.accent-soft
        : touch.pressed ? Theme.surface-hover
        : touch.has-hover ? Theme.surface-hover.with-alpha(0.7) : transparent;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.label;

    HorizontalLayout {
        // A small nudge to the right on hover.
        padding-left: touch.has-hover && !root.active ? 14px : 12px;
        animate padding-left { duration: Theme.normal; easing: ease-out-quint; }
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                tone: root.active ? Theme.accent-ink : touch.has-hover ? Theme.text : Theme.text-faint;
                animate tone { duration: Theme.fast; }
            }
        }
        Text {
            text: root.label;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: Theme.text-label;
            font-weight: root.active ? 600 : 500;
            color: root.active || touch.has-hover ? Theme.text : Theme.text-muted;
        }
        if root.soon: VerticalLayout {
            alignment: center;
            Pill {
                text: "Soon";
                tone: Theme.text-faint;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    FocusRing {
        show: focus.has-focus;
        radius: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
}

// The big call-to-action button, with a play icon.
export component PlayButton inherits Rectangle {
    in property <string> text: "Play";
    in property <bool> enabled: true;
    callback clicked;

    height: 52px;
    min-width: 196px;
    border-radius: 26px;
    background: !root.enabled ? Theme.surface-hover
        : touch.pressed ? Theme.accent-strong.darker(0.15)
        : touch.has-hover ? @linear-gradient(100deg, Theme.accent-hover 0%, Theme.accent.mix(Theme.accent-strong, 0.6) 100%)
        : @linear-gradient(100deg, Theme.accent-light 0%, Theme.accent-strong 100%);
    drop-shadow-blur: root.enabled ? (touch.has-hover ? 26px : 16px) : 0px;
    drop-shadow-offset-y: root.enabled ? 4px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(Theme.dark ? 0.38 : 0.3);
    transform-scale: root.enabled && touch.pressed ? 0.97 : 1;
    animate drop-shadow-blur { duration: 180ms; }
    animate transform-scale { duration: Theme.normal; easing: ease-out-back; }
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 26px;
        padding-right: 30px;
        spacing: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Path {
                width: 17px;
                height: 17px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.play;
                fill: root.enabled ? Theme.on-accent : Theme.text-faint;
                stroke: transparent;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 16px;
            font-weight: 700;
            color: root.enabled ? Theme.on-accent : Theme.text-faint;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    FocusRing {
        show: focus.has-focus;
        radius: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
}

// A quieter button, optionally with an icon. `danger` for actions that
// delete something; `primary` for the main action of a section.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> primary: false;
    callback clicked;

    property <color> tone: root.danger ? Theme.danger : Theme.accent;
    height: 36px;
    border-radius: Theme.radius-small;
    background: !root.enabled ? transparent
        : root.primary ? (touch.pressed ? Theme.accent-strong : touch.has-hover ? Theme.accent-light : Theme.accent)
        : touch.pressed ? root.tone.with-alpha(0.22)
        : touch.has-hover ? root.tone.with-alpha(0.12) : Theme.surface-raised;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border
        : root.primary ? transparent
        : touch.has-hover ? root.tone.with-alpha(0.45) : Theme.border;
    transform-scale: root.enabled && touch.pressed ? 0.96 : 1;
    opacity: root.enabled ? 1 : 0.6;
    animate background, border-color { duration: Theme.fast; }
    animate transform-scale { duration: Theme.fast; easing: ease-out-quad; }
    accessible-role: button;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 15px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 16px;
                height: 16px;
                commands: root.icon;
                tone: !root.enabled ? Theme.text-faint : root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.lavender;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 13px;
            font-weight: 600;
            color: !root.enabled ? Theme.text-faint : root.primary ? Theme.on-accent : root.danger && touch.has-hover ? Theme.danger : Theme.text;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    FocusRing {
        show: focus.has-focus;
        radius: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
}

// A button for something that can't be undone: the first click asks
// ("Sure? Click again" for 3 seconds), the second one acts.
export component ConfirmButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> enabled: true;
    callback confirmed;
    property <bool> armed: false;
    width: button.preferred-width;
    // The button's real height: its preferred one is smaller, which left
    // this button sitting higher than its neighbours in a row.
    height: button.height;
    button := SecondaryButton {
        width: 100%;
        text: root.armed ? "Sure? Click again" : root.text;
        icon: root.armed ? "" : root.icon;
        danger: true;
        primary: false;
        enabled: root.enabled;
        clicked => {
            if root.armed {
                root.armed = false;
                root.confirmed();
            } else {
                root.armed = true;
                disarm.running = true;
            }
        }
    }
    disarm := Timer {
        interval: 3s;
        running: false;
        triggered => {
            root.armed = false;
            self.running = false;
        }
    }
}

// An on/off switch with a sliding knob.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: !root.enabled ? (root.checked ? Theme.accent.with-alpha(0.35) : Theme.surface-hover)
        : root.checked ? (touch.has-hover ? Theme.accent-light : Theme.accent)
        : touch.has-hover ? Theme.border-strong : Theme.surface-hover;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.border-strong;
    animate background { duration: Theme.normal; }
    opacity: root.enabled ? 1 : 0.6;
    accessible-role: checkbox;
    accessible-checked: root.checked;

    Rectangle {
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.knob : (Theme.dark ? Theme.text-muted : Theme.knob);
        drop-shadow-blur: Theme.nudge-blur;
        drop-shadow-offset-y: Theme.nudge-offset / 2;
        drop-shadow-color: Theme.lift-color;
        animate x { duration: Theme.normal; easing: ease-out-back; }
        animate background { duration: Theme.normal; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
    }
    FocusRing {
        show: focus.has-focus;
        radius: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
}

// A row of equal-width tabs with a sliding highlight under the chosen one.
// With focus, the arrow keys move between tabs.
export component TabBar inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> current: 0;
    callback changed(int);
    property <length> tab-width: root.tabs.length > 0 ? (root.width - 8px) / root.tabs.length : 0px;

    height: 40px;
    border-radius: Theme.radius-small + 2px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: tab-list;

    // The highlight slides to the chosen tab and sits a little raised.
    Rectangle {
        x: 4px + root.current * root.tab-width;
        y: 4px;
        width: root.tab-width;
        height: parent.height - 8px;
        border-radius: Theme.radius-small - 1px;
        background: Theme.dark ? Theme.surface-hover : Theme.bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.nudge-blur;
        drop-shadow-offset-y: Theme.nudge-offset;
        drop-shadow-color: Theme.lift-color;
        animate x { duration: Theme.normal; easing: ease-out-quint; }
    }

    for tab[i] in root.tabs: Rectangle {
        x: 4px + i * root.tab-width;
        y: 4px;
        width: root.tab-width;
        height: parent.height - 8px;
        accessible-role: AccessibleRole.tab;
        accessible-label: tab;
        Text {
            text: tab;
            font-size: 13px;
            font-weight: root.current == i ? 600 : 500;
            color: root.current == i || area.has-hover ? Theme.text : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: Theme.fast; }
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.current = i;
                root.changed(i);
            }
        }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.RightArrow && root.current < root.tabs.length - 1 {
                root.current += 1;
                root.changed(root.current);
                return accept;
            }
            if event.text == Key.LeftArrow && root.current > 0 {
                root.current -= 1;
                root.changed(root.current);
                return accept;
            }
            return reject;
        }
    }
    FocusRing {
        show: focus.has-focus;
        radius: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
}

// A panel that stacks its children vertically, lifted off the floor. Fades
// and settles in when it appears.
export component Card inherits Rectangle {
    in property <length> inner-padding: 16px;
    property <bool> shown: false;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: Theme.lift-blur;
    drop-shadow-offset-y: Theme.lift-offset;
    drop-shadow-color: Theme.lift-color;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.normal; easing: ease-out-quad; }
    init => {
        root.shown = true;
    }
    VerticalLayout {
        padding: root.inner-padding;
        spacing: 8px;
        alignment: start;
        @children
    }
}

export component CardTitle inherits Text {
    font-size: Theme.text-title;
    font-weight: 700;
    color: Theme.text;
}

// A small heading for a group of rows ("Recently played", "Help"): sentence
// case, bold, in the secondary text colour. Not a shouty ALL CAPS label.
export component Eyebrow inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: Theme.text-muted;
}

export component BodyText inherits Text {
    font-size: Theme.text-body;
    color: Theme.text-muted;
    wrap: word-wrap;
}

export component PageTitle inherits Text {
    font-size: Theme.text-page;
    font-weight: 800;
    letter-spacing: -0.4px;
    color: Theme.text;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A page's title, description and optional actions on the right.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 16px;
    padding-bottom: 4px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 6px;
        PageTitle {
            text: root.title;
        }
        if root.description != "": BodyText {
            text: root.description;
        }
    }
    VerticalLayout {
        alignment: start;
        @children
    }
}

// A section heading with an icon, inside a card.
export component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> icon: "";
    spacing: 10px;
    alignment: start;
    if root.icon != "": Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: Theme.accent-soft;
        Icon {
            width: 14px;
            height: 14px;
            commands: root.icon;
            tone: Theme.lavender;
        }
    }
    Text {
        text: root.text;
        font-size: 14px;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
}

// A setting: label and help text on the left, a control (the children) on
// the right. `managed-reason` replaces the help when Feline overrides it.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> help;
    in property <string> managed-reason;
    spacing: 18px;
    padding-top: 6px;
    padding-bottom: 6px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: root.label;
                font-size: Theme.text-label;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.managed-reason != "": Pill {
                text: "Set by Feline";
                tone: Theme.lavender;
            }
        }
        if root.managed-reason != "": BodyText {
            text: root.managed-reason + ".";
            color: Theme.lavender;
        }
        if root.managed-reason == "" && root.help != "": BodyText {
            text: root.help;
        }
    }
    // The control keeps its own size; the text takes the rest.
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

// A message box: a status line with a coloured dot.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.accent;
    border-radius: Theme.radius-small;
    background: root.tone.with-alpha(Theme.dark ? 0.08 : 0.07);
    border-width: 1px;
    border-color: root.tone.with-alpha(Theme.dark ? 0.3 : 0.35);
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            padding-top: 5px;
            StatusDot {
                tone: root.tone;
            }
        }
        BodyText {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
        }
    }
}

// A friendly tip marked with a paw instead of a dot.
export component PawTip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.lavender;
    border-radius: Theme.radius-small;
    background: Theme.accent.with-alpha(Theme.dark ? 0.07 : 0.06);
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.25);
    HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Icon {
                width: 17px;
                height: 17px;
                commands: Icons.paw;
                tone: root.tone;
            }
        }
        BodyText {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
        }
    }
}

// A filled paw print, for decoration (the Home page's trail of steps).
export component PawPrint inherits Path {
    in property <length> size: 22px;
    in property <color> tone: Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.18);
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: Icons.paw;
    fill: root.tone;
    stroke: transparent;
}

// A small cat face with a message, for lists with nothing in them yet.
export component CatEmpty inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    spacing: 8px;
    padding: 18px;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Icon {
            width: 38px;
            height: 38px;
            commands: Icons.cat;
            tone: Theme.lavender.with-alpha(0.8);
        }
    }
    Text {
        text: root.title;
        horizontal-alignment: center;
        font-size: 15px;
        font-weight: 700;
        color: Theme.text;
    }
    if root.text != "": BodyText {
        text: root.text;
        horizontal-alignment: center;
    }
}

// A small lifted tile with an icon, a label and a value (Home page facts).
export component StatTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.lavender;
    property <bool> shown: false;
    min-height: 58px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: Theme.lift-blur;
    drop-shadow-offset-y: Theme.lift-offset;
    drop-shadow-color: Theme.lift-color;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.slow; easing: ease-out-quad; }
    init => {
        root.shown = true;
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 11px;
            background: root.tone.with-alpha(0.12);
            Icon {
                commands: root.icon;
                tone: root.tone;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 12px;
                color: Theme.text-faint;
            }
            Text {
                text: root.value;
                font-size: Theme.text-label;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
            }
        }
    }
}

// A read-only, scrollable box of monospace text with a Copy button, for
// command output and reports. Slint has no clipboard API for Rust, so copying
// goes through the text box itself: select everything, then copy.
export component OutputBox inherits Rectangle {
    in property <string> text;
    in property <string> placeholder: "Nothing here yet.";
    property <bool> copied: false;

    min-height: 160px;
    border-radius: Theme.radius-small;
    background: Theme.inset;
    border-width: 1px;
    border-color: Theme.border;

    if root.text == "": Text {
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Always present (an element inside `if` can't be referenced from
    // outside it), just hidden while there's no text.
    Rectangle {
        visible: root.text != "";
        VerticalLayout {
            padding: 2px;
            box := TextEdit {
                text: root.text;
                read-only: true;
                font-size: 12px;
                font-family: "monospace";
                wrap: word-wrap;
            }
        }
    }
    // Floating Copy button in the top-right corner.
    SecondaryButton {
        visible: root.text != "";
        // Without a width it fills the box and covers the first lines.
        width: self.preferred-width;
        x: parent.width - self.width - 22px;
        y: 10px;
        text: root.copied ? "Copied" : "Copy";
        icon: root.copied ? Icons.check : Icons.copy;
        clicked => {
            box.select-all();
            box.copy();
            box.clear-selection();
            root.copied = true;
            reset-copied.running = true;
        }
    }
    // Turns "Copied" back into "Copy" after a moment.
    reset-copied := Timer {
        interval: 1800ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }
}

// A label/value line, e.g. "Kernel   6.18.58_1".
export component InfoLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    min-height: 36px;
    HorizontalLayout {
        spacing: 16px;
        Text {
            width: 150px;
            text: root.label;
            font-size: 13px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            font-size: 13px;
            font-weight: 600;
            color: root.value-color;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
