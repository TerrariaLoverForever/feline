// SPDX-License-Identifier: GPL-3.0-or-later
// The Feline main window: sidebar navigation plus the current page.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Extras, AchievementTile } from "extras.slint";
import { ModTools } from "mod_tools.slint";
import { PlayExtras, ProgramRow } from "play_extras.slint";
import { More, VisitRow, LibraryRow, IconRow, AccountRow } from "more.slint";
import { Looks } from "looks.slint";
import { TweaksState, FlagRow } from "tweaks_state.slint";
import { TweaksPage } from "pages/tweaks.slint";
import { Page, LaunchState, RuntimeRow, Level, InfoRow, CheckRow, SettingKind, SettingRow, RuntimeTab, ModRow, FoundRow, GameCard, TopGame, VersionRow, GameProfileRow, ServerRow, DriverRow, CaseRow, ProbeRow } from "types.slint";
import { Icons } from "icons.slint";
import { Logo, NavItem, Eyebrow, StatusDot } from "components.slint";
import { HomePage } from "pages/home.slint";
import { RuntimesPage } from "pages/runtimes.slint";
import { SettingsPage } from "pages/settings.slint";
import { SystemPage } from "pages/system.slint";
import { DiagnosticsPage } from "pages/diagnostics.slint";
import { AboutPage } from "pages/about.slint";
import { ModsPage } from "pages/mods.slint";
import { LibraryPage } from "pages/library.slint";
import { StudioPage } from "pages/studio.slint";
import { ServersPage } from "pages/servers.slint";
import { RobloxExtras } from "pages/roblox_extras.slint";
import { AccountNotice } from "pages/notice.slint";

// Make the shared types visible to Rust.
export { Theme, Extras, AchievementTile, TweaksState, FlagRow, ModTools, PlayExtras, ProgramRow, More, VisitRow, LibraryRow, IconRow, AccountRow, Looks }
export { Page, LaunchState, RuntimeRow, Level, InfoRow, CheckRow, SettingKind, SettingRow, RuntimeTab, ModRow, FoundRow, GameCard, TopGame, VersionRow, GameProfileRow, ServerRow, DriverRow, CaseRow, ProbeRow }

export component AppWindow inherits Window {
    title: "Feline";
    icon: @image-url("../../../assets/icons/hicolor/256x256/apps/feline.png");
    preferred-width: 1160px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 660px;
    // With Windows 11's glass, the window itself is see-through and the
    // glass shows behind a thin wash of Feline's background.
    background: Looks.glass > 0 ? Theme.bg.with-alpha(0.55) : Theme.bg;
    default-font-family: Looks.font;
    default-font-size: 14px;
    default-font-weight: 400;

    // The standard widgets (text fields, drop-downs, scroll bars) follow
    // Feline's light or dark den.
    property <bool> dark-den: Theme.dark;
    init => {
        Palette.color-scheme = root.dark-den ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-den => {
        Palette.color-scheme = root.dark-den ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <Page> page: Page.home;
    in property <string> version;
    // True on Windows: shows the Windows wording and hides Linux-only parts.
    in property <bool> windows;

    // Runtimes (set from Rust)
    in property <[RuntimeRow]> runtimes;
    in property <[RuntimeRow]> feline-runtimes;
    in property <bool> detecting: true;
    in property <string> runtimes-error;
    in property <string> selected-name;
    in property <string> selected-detail;
    in property <bool> selected-has-doctor;
    in property <bool> selected-has-info;
    // The runtime whose own page is open on Runtimes ("" = the list).
    in-out property <string> runtime-open;
    // The open tab of the Settings page.
    in-out property <int> settings-tab;
    // The open tab of a runtime's page.
    in-out property <int> runtime-tab;
    // The open tab of the About page.
    in-out property <int> about-tab;

    // Launching (set from Rust)
    in property <LaunchState> launch-state: LaunchState.idle;
    in property <string> launch-title;
    in property <string> launch-detail;
    // Basic monitoring while the game runs (set from Rust)
    in property <string> stat-time;
    in property <string> stat-cpu;
    in property <string> stat-memory;
    in property <string> stat-game;
    in property <string> stat-region;
    // Home: greeting, playtime, games (set from Rust)
    in property <string> greeting: "Ready to pounce?";
    in property <string> play-today;
    in property <string> play-week;
    in property <string> play-total;
    in property <[GameCard]> recent-games;
    in property <[GameCard]> favourite-games;
    in property <[TopGame]> top-games;
    in property <[GameCard]> discord-games;
    callback home-opened();
    // Roblox page tools (set from Rust)
    in property <string> rx-runtime;
    in property <string> rx-health;
    in property <bool> rx-health-ok;
    in property <bool> rx-health-checking;
    in property <[string]> rx-health-problems;
    in property <[VersionRow]> rx-versions;
    in property <[string]> rx-profiles;
    in property <[string]> rx-choices;
    in property <[GameProfileRow]> rx-game-profiles;
    in property <int> rx-everyday;
    in property <bool> rx-has-settings;
    in property <string> rx-message;
    callback roblox-opened();
    callback rx-check-health();
    callback rx-save-profile(string);
    callback rx-apply-profile(string);
    callback rx-delete-profile(string);
    callback rx-set-game-profile(string, int);
    callback rx-repair();
    // Server picker
    in property <string> servers-game;
    in property <[ServerRow]> servers;
    in property <bool> servers-loading;
    in property <string> servers-error;
    in-out property <int> servers-sort;
    callback open-servers(string);
    callback reload-servers(int);
    callback join-server(string);
    callback quick-join(int);
    in property <bool> can-rejoin;
    callback rejoin();
    callback server-hop();
    callback play-place(string);
    callback toggle-favourite(string);
    callback toggle-discord-hidden(string);
    // Discord extras
    in property <string> discord-text;
    in property <bool> discord-region;
    in property <bool> discord-today;
    callback set-discord-text(string);
    in property <string> roblox-status;

    callback play();
    callback select-runtime(string);
    callback rescan();
    callback open-logs();

    // First-run account notice
    in-out property <bool> show-notice;
    callback accept-notice();
    callback quit();

    // System page (set from Rust)
    in property <[InfoRow]> system-rows;
    in property <string> system-report;
    in property <bool> system-loading: true;
    callback refresh-system();
    in property <Level> verdict-level;
    in property <string> verdict-title;
    in property <string> verdict-detail;
    in property <[CheckRow]> pc-checks;
    in property <[DriverRow]> drivers;
    in property <[float]> cpu-history;
    in property <[float]> roblox-cpu-history;
    in property <[float]> memory-history;
    in property <[float]> roblox-memory-history;
    in property <string> cpu-now;
    in property <string> memory-now;
    in property <string> roblox-now;
    callback system-tick();
    callback open-link(string);

    // Diagnostics page (set from Rust)
    in property <[CheckRow]> checks;
    in property <bool> diag-running;
    in property <string> diag-title;
    in property <Level> diag-level;
    in property <string> diag-output;
    in property <string> log-folder;
    callback run-doctor();
    callback run-runtime-info();
    callback build-report();
    in property <[CheckRow]> clues;
    in property <[CaseRow]> cases;
    in property <bool> investigating;
    callback investigate();
    in property <[ProbeRow]> probes;
    in property <Level> net-level;
    in property <string> net-title;
    in property <string> net-detail;
    in property <bool> net-running;
    callback run-network-test();
    callback save-report-zip();

    // Feline's settings (set from Rust)
    in property <int> renderer-index;
    in property <int> gamemode-index;
    in property <int> close-index;
    // Feline's own options (set-override keys "after-launch", "priority",
    // "fast-gpu", "verify-roblox"; on/off ones use 0/1).
    in property <int> after-launch-index;
    in property <int> priority-index;
    in property <bool> fast-gpu;
    in property <bool> verify-roblox;
    in property <bool> close-stuck;
    in property <bool> close-on-leave;
    in property <bool> roblox-icon;
    in property <int> title-bar-index;
    in property <string> roblox-data-size;
    in property <int> break-index;

    // Mods page (set from Rust)
    in property <[ModRow]> mod-rows;
    in property <[FoundRow]> mods-found;
    in property <bool> mods-supported;
    in property <string> mods-support;
    in property <string> mods-status;
    in property <string> mods-folder;
    in property <bool> mods-theme-installed;
    callback get-theme();
    in property <[bool]> mods-picks: [false, false, false, false, false];
    in property <[string]> mods-profiles;
    in property <[string]> mods-conflicts;
    callback pick-file(int);
    callback clear-pick(int);
    callback save-mod-profile(string);
    callback apply-mod-profile(string);
    callback delete-mod-profile(string);
    callback listen-mod(string);
    callback mods-opened();
    callback toggle-mod(string, bool);
    callback import-mods(string);
    callback open-mods-folder();
    callback restore-mods();
    in property <string> apply-status;
    in property <Level> apply-level;
    in property <[RuntimeTab]> settings-tabs;
    in property <bool> discord-on;
    in property <bool> discord-user;
    in property <bool> discord-join;
    in property <bool> discord-game;
    in property <bool> discord-menus;
    in property <bool> link-handler;
    in property <string> link-status;
    in property <string> presence-status;
    // Updates, privacy and storage
    in property <bool> roblox-updates;
    in property <int> log-days-index;
    in property <bool> has-saved-login;
    in property <string> size-roblox-cache;
    in property <string> size-shader-cache;
    in property <string> space-total;
    in property <string> space-change;
    in property <[float]> space-history;
    in property <int> tidy-index;
    in property <string> last-tidy;
    in property <string> size-roblox-logs;
    in property <string> size-feline-logs;
    in property <string> size-roblox-versions;
    in property <string> housekeeping-status;
    callback set-link-handler(bool);
    callback set-presence(string, bool);
    callback settings-opened();
    callback set-override(string, int);
    callback set-runtime-bool(string, string, bool);
    callback set-runtime-choice(string, string, int);
    callback set-runtime-number(string, string, int);
    callback set-runtime-text(string, string, string);
    callback set-roblox-updates(bool);
    callback set-log-days(int);
    callback housekeeping(string);
    callback tweaks-opened();
    // Ends Feline (even with "keep running" on).
    callback quit-feline();

    // Behind everything: a gradient, or your picture under a wash of the
    // background so text stays readable.
    if Looks.background == 1: Rectangle {
        background: @linear-gradient(135deg, Theme.accent.with-alpha(0.32) 0%, Theme.bg.with-alpha(0) 55%, Theme.accent.with-alpha(0.14) 100%);
    }
    if Looks.background == 2: Image {
        width: parent.width;
        height: parent.height;
        source: Looks.picture;
        image-fit: cover;
    }
    if Looks.background == 2: Rectangle {
        background: Theme.bg.with-alpha(0.8);
    }

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 210px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 12px;
                padding-top: 16px;
                spacing: 2px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 14px;
                    spacing: 12px;
                    alignment: start;
                    // No glow here: the page's own main action is the lamp.
                    Logo {
                        size: 38px;
                        playful: true;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "Feline";
                            font-size: 18px;
                            font-weight: 800;
                            color: Theme.text;
                        }
                        Text {
                            text: "Roblox, the cat way";
                            font-size: 11.5px;
                            color: Theme.text-faint;
                        }
                    }
                }

                NavItem {
                    label: "Home";
                    icon: Icons.home;
                    active: root.page == Page.home;
                    clicked => {
                        root.page = Page.home;
                        root.home-opened();
                    }
                }
                NavItem {
                    label: root.windows ? "Roblox" : "Runtimes";
                    icon: Icons.runtimes;
                    active: root.page == Page.runtimes;
                    clicked => {
                        if root.page == Page.runtimes {
                            root.runtime-open = "";
                        }
                        root.page = Page.runtimes;
                        root.settings-opened();
                        root.roblox-opened();
                    }
                }
                NavItem {
                    label: "Studio";
                    icon: Icons.sparkles;
                    active: root.page == Page.studio;
                    clicked => {
                        root.page = Page.studio;
                    }
                }
                NavItem {
                    label: "Mods";
                    icon: Icons.paw;
                    active: root.page == Page.mods;
                    clicked => {
                        root.page = Page.mods;
                        root.mods-opened();
                    }
                }
                NavItem {
                    label: "Library";
                    icon: Icons.archive;
                    active: root.page == Page.library;
                    clicked => {
                        root.page = Page.library;
                        if More.library.length == 0 {
                            More.load-library();
                        }
                    }
                }
                NavItem {
                    label: "Tweaks";
                    icon: Icons.sliders;
                    active: root.page == Page.tweaks;
                    clicked => {
                        root.page = Page.tweaks;
                        root.tweaks-opened();
                    }
                }
                NavItem {
                    label: "Settings";
                    icon: Icons.settings;
                    active: root.page == Page.settings;
                    clicked => {
                        root.page = Page.settings;
                        root.settings-opened();
                    }
                }

                Eyebrow {
                    text: "Help";
                    height: 34px;
                    vertical-alignment: bottom;
                    horizontal-alignment: left;
                }
                Rectangle {
                    height: 4px;
                }
                NavItem {
                    label: "System";
                    icon: Icons.system;
                    active: root.page == Page.system;
                    clicked => {
                        root.page = Page.system;
                    }
                }
                NavItem {
                    label: "Diagnostics";
                    icon: Icons.stethoscope;
                    active: root.page == Page.diagnostics;
                    clicked => {
                        root.page = Page.diagnostics;
                    }
                }
                NavItem {
                    label: "About";
                    icon: Icons.about;
                    active: root.page == Page.about;
                    clicked => {
                        root.page = Page.about;
                    }
                }

                // Pushes the footer to the bottom.
                Rectangle {
                    vertical-stretch: 1;
                }

                // With "keep running", closing the window doesn't end
                // Feline; this does.
                if More.keep-running: NavItem {
                    label: "Quit Feline";
                    icon: Icons.logout;
                    clicked => {
                        root.quit-feline();
                    }
                }

                // The chosen runtime, and whether a game is running.
                Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            StatusDot {
                                tone: root.launch-state == LaunchState.running ? Theme.success
                                    : root.launch-state == LaunchState.starting ? Theme.warning
                                    : root.selected-name != "" ? Theme.success : Theme.text-faint;
                                pulse: root.launch-state == LaunchState.starting;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.launch-state == LaunchState.running ? "Playing"
                                    : root.launch-state == LaunchState.starting ? "Starting…" : (root.windows ? "Roblox" : "Runtime");
                                font-size: 11px;
                                color: Theme.text-faint;
                            }
                            Text {
                                text: root.selected-name != "" ? root.selected-name : "Nothing chosen";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.page = Page.runtimes;
                            root.runtime-open = "";
                        }
                    }
                }
                Text {
                    text: "v" + root.version + " · GPL-3.0 · not affiliated with Roblox";
                    font-size: 10.5px;
                    color: Theme.text-faint;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    height: 30px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // Current page
        if root.page == Page.home: HomePage {
            windows: root.windows;
            horizontal-stretch: 1;
            selected-name: root.selected-name;
            selected-detail: root.selected-detail;
            detecting: root.detecting;
            launch-state: root.launch-state;
            launch-title: root.launch-title;
            launch-detail: root.launch-detail;
            stat-time: root.stat-time;
            stat-cpu: root.stat-cpu;
            stat-memory: root.stat-memory;
            stat-game: root.stat-game;
            stat-region: root.stat-region;
            roblox-status: root.roblox-status;
            discord-on: root.discord-on;
            greeting: root.greeting;
            play-today: root.play-today;
            play-week: root.play-week;
            play-total: root.play-total;
            recent: root.recent-games;
            favourites: root.favourite-games;
            top: root.top-games;
            play => {
                root.play();
            }
            play-place(p) => {
                root.play-place(p);
            }
            can-rejoin: root.can-rejoin;
            rejoin => {
                root.rejoin();
            }
            server-hop => {
                root.server-hop();
            }
            toggle-favourite(p) => {
                root.toggle-favourite(p);
            }
            open-servers(p) => {
                root.open-servers(p);
            }
            choose-runtime => {
                root.page = Page.runtimes;
                root.runtime-open = "";
            }
            open-logs => {
                root.open-logs();
            }
        }
        if root.page == Page.runtimes: RuntimesPage {
            windows: root.windows;
            horizontal-stretch: 1;
            runtimes: root.runtimes;
            feline-runtimes: root.feline-runtimes;
            detecting: root.detecting;
            error: root.runtimes-error;
            open: root.runtime-open;
            tabs: root.settings-tabs;
            runtime-tab <=> root.runtime-tab;
            select(key) => {
                root.select-runtime(key);
            }
            rescan => {
                root.rescan();
            }
            open-runtime(id) => {
                root.runtime-tab = 0;
                root.runtime-open = id;
                root.settings-opened();
            }
            set-bool(tab, key, value) => {
                root.set-runtime-bool(tab, key, value);
            }
            set-choice(tab, key, index) => {
                root.set-runtime-choice(tab, key, index);
            }
            set-number(tab, key, value) => {
                root.set-runtime-number(tab, key, value);
            }
            set-text(tab, key, value) => {
                root.set-runtime-text(tab, key, value);
            }
            RobloxExtras {
                show: root.runtime-open == "";
                windows: root.windows;
                runtime: root.rx-runtime;
                health: root.rx-health;
                health-ok: root.rx-health-ok;
                health-checking: root.rx-health-checking;
                health-problems: root.rx-health-problems;
                versions: root.rx-versions;
                profiles: root.rx-profiles;
                choices: root.rx-choices;
                game-profiles: root.rx-game-profiles;
                everyday-profile: root.rx-everyday;
                has-settings: root.rx-has-settings;
                message: root.rx-message;
                check-health => {
                    root.rx-check-health();
                }
                save-profile(n) => {
                    root.rx-save-profile(n);
                }
                apply-profile(n) => {
                    root.rx-apply-profile(n);
                }
                delete-profile(n) => {
                    root.rx-delete-profile(n);
                }
                set-game-profile(p, i) => {
                    root.rx-set-game-profile(p, i);
                }
                repair => {
                    root.rx-repair();
                }
            }
        }
        if root.page == Page.servers: ServersPage {
            game: root.servers-game;
            servers: root.servers;
            loading: root.servers-loading;
            error: root.servers-error;
            sort <=> root.servers-sort;
            back => {
                root.page = Page.home;
            }
            reload(i) => {
                root.reload-servers(i);
            }
            join(id) => {
                root.join-server(id);
            }
            join-any => {
                root.join-server("");
            }
            quick-join(i) => {
                root.quick-join(i);
            }
        }
        if root.page == Page.tweaks: TweaksPage {
            windows: root.windows;
        }
        if root.page == Page.library: LibraryPage { }
        if root.page == Page.studio: StudioPage { }
        if root.page == Page.mods: ModsPage {
            windows: root.windows;
            mods: root.mod-rows;
            found: root.mods-found;
            supported: root.mods-supported;
            support: root.mods-support;
            status: root.mods-status;
            folder: root.mods-folder;
            theme-installed: root.mods-theme-installed;
            picks: root.mods-picks;
            mod-profiles: root.mods-profiles;
            conflicts: root.mods-conflicts;
            pick(k) => {
                root.pick-file(k);
            }
            clear-pick(k) => {
                root.clear-pick(k);
            }
            save-mod-profile(n) => {
                root.save-mod-profile(n);
            }
            apply-mod-profile(n) => {
                root.apply-mod-profile(n);
            }
            delete-mod-profile(n) => {
                root.delete-mod-profile(n);
            }
            listen(n) => {
                root.listen-mod(n);
            }
            get-theme => {
                root.get-theme();
            }
            toggle(name, on) => {
                root.toggle-mod(name, on);
            }
            import(name) => {
                root.import-mods(name);
            }
            open-folder => {
                root.open-mods-folder();
            }
            rescan => {
                root.mods-opened();
            }
            restore => {
                root.restore-mods();
            }
        }
        if root.page == Page.settings: SettingsPage {
            windows: root.windows;
            horizontal-stretch: 1;
            current <=> root.settings-tab;
            renderer-index: root.renderer-index;
            gamemode-index: root.gamemode-index;
            close-index: root.close-index;
            apply-status: root.apply-status;
            apply-level: root.apply-level;
            after-launch-index: root.after-launch-index;
            priority-index: root.priority-index;
            fast-gpu: root.fast-gpu;
            verify-roblox: root.verify-roblox;
            close-stuck: root.close-stuck;
            close-on-leave: root.close-on-leave;
            roblox-icon: root.roblox-icon;
            title-bar-index: root.title-bar-index;
            roblox-data-size: root.roblox-data-size;
            discord-text: root.discord-text;
            discord-region: root.discord-region;
            discord-today: root.discord-today;
            discord-games: root.discord-games;
            set-discord-text(t) => {
                root.set-discord-text(t);
            }
            toggle-discord-hidden(p) => {
                root.toggle-discord-hidden(p);
            }
            break-index: root.break-index;
            discord-on: root.discord-on;
            discord-user: root.discord-user;
            discord-join: root.discord-join;
            discord-game: root.discord-game;
            discord-menus: root.discord-menus;
            link-handler: root.link-handler;
            link-status: root.link-status;
            presence-status: root.presence-status;
            roblox-updates: root.roblox-updates;
            roblox-status: root.roblox-status;
            log-days-index: root.log-days-index;
            has-saved-login: root.has-saved-login;
            size-roblox-cache: root.size-roblox-cache;
            size-shader-cache: root.size-shader-cache;
            space-total: root.space-total;
            space-change: root.space-change;
            space-history: root.space-history;
            tidy-index: root.tidy-index;
            last-tidy: root.last-tidy;
            size-roblox-logs: root.size-roblox-logs;
            size-feline-logs: root.size-feline-logs;
            size-roblox-versions: root.size-roblox-versions;
            housekeeping-status: root.housekeeping-status;
            set-link-handler(on) => {
                root.set-link-handler(on);
            }
            set-presence(which, value) => {
                root.set-presence(which, value);
            }
            set-override(which, index) => {
                root.set-override(which, index);
            }
            set-roblox-updates(on) => {
                root.set-roblox-updates(on);
            }
            set-log-days(i) => {
                root.set-log-days(i);
            }
            housekeeping(action) => {
                root.housekeeping(action);
            }
            open-runtime-privacy => {
                root.runtime-open = "feline";
                root.runtime-tab = 2;
                root.page = Page.runtimes;
                root.settings-opened();
            }
        }
        if root.page == Page.system: SystemPage {
            windows: root.windows;
            horizontal-stretch: 1;
            rows: root.system-rows;
            report: root.system-report;
            loading: root.system-loading;
            verdict-level: root.verdict-level;
            verdict-title: root.verdict-title;
            verdict-detail: root.verdict-detail;
            pc-checks: root.pc-checks;
            drivers: root.drivers;
            cpu-history: root.cpu-history;
            roblox-cpu-history: root.roblox-cpu-history;
            memory-history: root.memory-history;
            roblox-memory-history: root.roblox-memory-history;
            cpu-now: root.cpu-now;
            memory-now: root.memory-now;
            roblox-now: root.roblox-now;
            refresh => {
                root.refresh-system();
            }
            tick => {
                root.system-tick();
            }
            open-link(url) => {
                root.open-link(url);
            }
        }
        if root.page == Page.diagnostics: DiagnosticsPage {
            windows: root.windows;
            horizontal-stretch: 1;
            checks: root.checks;
            checks-loading: root.system-loading;
            runtime-name: root.selected-name;
            runtime-has-doctor: root.selected-has-doctor;
            runtime-has-info: root.selected-has-info;
            running: root.diag-running;
            result-title: root.diag-title;
            result-level: root.diag-level;
            output: root.diag-output;
            log-folder: root.log-folder;
            clues: root.clues;
            cases: root.cases;
            investigating: root.investigating;
            probes: root.probes;
            net-level: root.net-level;
            net-title: root.net-title;
            net-detail: root.net-detail;
            net-running: root.net-running;
            investigate => {
                root.investigate();
            }
            run-network-test => {
                root.run-network-test();
            }
            save-report-zip => {
                root.save-report-zip();
            }
            run-doctor => {
                root.run-doctor();
            }
            run-runtime-info => {
                root.run-runtime-info();
            }
            build-report => {
                root.build-report();
            }
            open-logs => {
                root.open-logs();
            }
            choose-runtime => {
                root.page = Page.runtimes;
                root.runtime-open = "";
            }
        }
        if root.page == Page.about: AboutPage {
            windows: root.windows;
            horizontal-stretch: 1;
            version: root.version;
            current <=> root.about-tab;
            show-notice => {
                root.show-notice = true;
            }
            open-link(url) => {
                root.open-link(url);
            }
        }
    }

    // Drawn last, so it covers everything else.
    if root.show-notice: AccountNotice {
            windows: root.windows;
        width: parent.width;
        height: parent.height;
        accepted => {
            root.accept-notice();
        }
        quit => {
            root.quit();
        }
    }
}
