// Feline's design tokens. Every color, size and timing used by the UI comes
// from here, so the look can be adjusted in one place.
//
// The palette is a calm, neutral slate with a soft violet accent: low
// contrast between surfaces (easy on the eyes in a dark room), clear contrast
// for text, and color only where it means something.

import { Level } from "types.slint";

export global Theme {
    // Backgrounds, darkest first
    out property <color> bg: #111218;
    out property <color> sidebar: #0d0e13;
    out property <color> surface: #171820;
    out property <color> surface-raised: #1d1f29;
    out property <color> surface-hover: #242633;
    out property <color> border: #252735;
    out property <color> border-strong: #343749;

    // Text
    out property <color> text: #ebebf3;
    out property <color> text-muted: #a5a7ba;
    out property <color> text-faint: #6d7086;

    // Brand: a calm violet, from the Feline icon
    out property <color> accent: #8f7ef7;
    out property <color> accent-strong: #7a67f2;
    out property <color> accent-soft: #8f7ef71f;
    out property <color> lavender: #cdc5ff;
    out property <color> on-accent: #ffffff;

    // Status
    out property <color> success: #5fcf98;
    out property <color> warning: #e9b860;
    out property <color> danger: #ef6f80;
    out property <color> info: #67b4f0;

    // Shape
    out property <length> radius: 14px;
    out property <length> radius-small: 10px;
    out property <length> radius-large: 20px;

    // Type scale
    out property <length> text-small: 12px;
    out property <length> text-body: 13.5px;
    out property <length> text-title: 16px;
    out property <length> text-page: 28px;

    // Motion: everything animates only in response to something (no idle
    // animations, so the launcher costs nothing while you play).
    out property <duration> fast: 130ms;
    out property <duration> normal: 240ms;
    out property <duration> slow: 360ms;

    // The color for a status level (used by dots, pills and values).
    public pure function level-color(level: Level) -> color {
        if level == Level.ok {
            return self.success;
        }
        if level == Level.warning {
            return self.warning;
        }
        if level == Level.problem {
            return self.danger;
        }
        return self.text-faint;
    }
}
